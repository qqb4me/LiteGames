--- !u!114 &2093999067
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2093999061}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7db63c401f8aba54ab21e9df906e9a3d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SimpleDialog
  dialogCanvases:
  - {fileID: 1907536764}
  - {fileID: 402215099}
  - {fileID: 201589434}
  dialogTexts:
  - {fileID: 1932128859}
  - {fileID: 995530979}
  - {fileID: 1676394102}
  messages:
  - dialogNumber: 1
    message: "\u0410\u0432\u0442\u043E\u0440:                                                                                                                 
      \u0421\u0442\u043E\u0438\u0442 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F
      \u0434\u0435\u0432\u043E\u0447\u043A\u0430, \u043C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F
      \u043E\u043D\u0430 \u0437\u0430\u0431\u043E\u043B\u0435\u043B\u0430"
  - dialogNumber: 3
    message: "\u041C\u0438\u043B\u044C\u0434\u0430:                                                                                                                
      \u0424\u0438\u043D, \u0430 \u0433\u0434\u0435 \u0434\u044F\u0434\u044F \u0412\u0430\u0440\u0435\u043D?"
  - dialogNumber: 2
    message: "\u0424\u0438\u043D:                                                                                                                                
      \u041E\u043D \u0443\u0435\u0445\u0430\u043B. \u0427\u0442\u043E \u0441 \u0442\u043E\u0431\u043E\u0439?"
  - dialogNumber: 3
    message: "\u041C\u0438\u043B\u044C\u0434\u0430:                                                                                                                                 
      \u042F \u0447\u0435\u043C-\u0442\u043E \u0437\u0430\u0431\u043E\u043B\u0435\u043B\u0430,
      \u0433\u043E\u043B\u043E\u0432\u0430 \u043A\u0440\u0443\u0436\u0438\u0442\u0441\u044F.."
  - dialogNumber: 1
    message: "\u0410\u0432\u0442\u043E\u0440:                                                                                                                
      \u041C\u0438\u043B\u044C\u0434\u0430 \u043F\u043E\u043A\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F.
      \u0415\u0451 \u0449\u0451\u043A\u0438 \u043D\u0435\u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E
      \u043A\u0440\u0430\u0441\u043D\u044B\u0435,\r\n\u0434\u044B\u0445\u0430\u043D\u0438\u0435
      \u0442\u044F\u0436\u0451\u043B\u043E\u0435"
  - dialogNumber: 2
    message: "\u0424\u0438\u043D:\r\n..\u041A\u0430\u0448\u0435\u043B\u044C?"
  - dialogNumber: 3
    message: "\u041C\u0438\u043B\u044C\u0434\u0430:\r\n\u041A\u0438\u0432\u0430\u0435\u0442,
      \u0432\u044B\u0442\u0438\u0440\u0430\u0435\u0442 \u043D\u043E\u0441 \u0440\u0443\u043A\u0430\u0432\u043E\u043C
      \u0440\u0443\u0431\u0430\u0448\u043A\u0438 \u0432 \u0433\u043E\u0440\u043E\u0448\u0435\u043A"
  - dialogNumber: 3
    message: "\u041C\u0438\u043B\u044C\u0434\u0430:\r\n\u041F\u0430\u043F\u0430 \u0441\u043A\u0430\u0437\u0430\u043B,
      \u0441\u0445\u043E\u0434\u0438\u0442\u044C \u043A \u0434\u044F\u0434\u0435
      \u0412\u0430\u0440\u0435\u043D\u0443, \u043D\u043E \u0435\u0433\u043E \u043D\u0435\u0442.."
  - dialogNumber: 2
    message: "\u0424\u0438\u043D:\r\n\u0421\u0436\u0438\u043C\u0430\u0435\u0442 \u043A\u0443\u043B\u0430\u043A\u0438,
      \u043D\u043E \u0441\u0442\u0430\u0440\u0430\u0435\u0442\u0441\u044F \u0443\u043B\u044B\u0431\u043D\u0443\u0442\u044C\u0441\u044F"
  - dialogNumber: 2
    message: "\u0424\u0438\u043D:\r\n\u0423\u0447\u0438\u0442\u0435\u043B\u044C \u043D\u0430\u0443\u0447\u0438\u043B
      \u043C\u0435\u043D\u044F \u043F\u0440\u043E\u0441\u0442\u043E\u043C\u0443 \u0440\u0435\u0446\u0435\u043F\u0442\u0443
      \u043E\u0442 \u043F\u0440\u043E\u0441\u0442\u0443\u0434\u044B. \u042F\r\n\u043F\u043E\u0441\u043C\u043E\u0442\u0440\u044E... "
  - dialogNumber: 2
    message: "\u0424\u0438\u043D:                                                                                                                
      \u0423 \u043C\u0435\u043D\u044F \u0442\u043E\u0447\u043D\u043E \u0435\u0441\u0442\u044C
      \u0440\u0435\u0446\u0435\u043F\u0442 \u0432 \u0434\u043D\u0435\u0432\u043D\u0438\u043A\u0435."
  - dialogNumber: 2
    message: "\u0424\u0438\u043D:\r\n\u0422\u043E\u043B\u044C\u043A\u043E \u043C\u043D\u0435
      \u043D\u0443\u0436\u043D\u043E \u0441\u0445\u043E\u0434\u0438\u0442\u044C \u0432
      \u043B\u0435\u0441 \u0437\u0430 \u0442\u0440\u0430\u0432\u0430\u043C\u0438.
      \u0422\u044B\r\n\u043F\u043E\u0434\u043E\u0436\u0434\u0438 \u0437\u0434\u0435\u0441\u044C,
      \u043B\u0430\u0434\u043D\u043E?"
  - dialogNumber: 3
    message: "\u041C\u0438\u043B\u044C\u0434\u0430:                                                                                                                
      \u0422\u044B \u0441\u043F\u0440\u0430\u0432\u0438\u0448\u044C\u0441\u044F?
      \u0422\u044B \u0436\u0435 \u0435\u0449\u0451 \u0443\u0447\u0438\u0448\u044C\u0441\u044F..."
  - dialogNumber: 2
    message: "\u0424\u0438\u043D:\r\n\u042F \u0435\u0449\u0451 \u043C\u043D\u043E\u0433\u043E\u043C\u0443
      \u043D\u0435 \u043D\u0430\u0443\u0447\u0438\u043B\u0441\u044F... \u041D\u043E
      \u044D\u0442\u043E \u0437\u0435\u043B\u044C\u0435 \u044F \u0442\u043E\u0447\u043D\u043E
      \u0441\u043C\u043E\u0433\u0443\r\n\u0441\u0434\u0435\u043B\u0430\u0442\u044C."
  - dialogNumber: 2
    message: "\u0424\u0438\u043D:                                                                                                                
      \u041E\u0431\u0435\u0449\u0430\u044E."
  - dialogNumber: 1
    message: "\u0410\u0432\u0442\u043E\u0440:                                                                                                                
      \u0424\u0438\u043D \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u043A
      \u0441\u0442\u043E\u043B\u0443 \u0438 \u0431\u0435\u0440\u0435\u0442 \u0434\u043D\u0435\u0432\u043D\u0438\u043A. "
  - dialogNumber: 1
    message: "\u0410\u0432\u0442\u043E\u0440:                                                                                                                 
      \u041D\u0430 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0435 \u0437\u0430\u0433\u043E\u0440\u0430\u0435\u0442\u0441\u044F
      \u043A\u043E\u043D\u0442\u0443\u0440 \u0437\u0435\u043B\u044C\u044F \u0438
      \u0441\u043F\u0438\u0441\u043E\u043A \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442\u043E\u0432"
  - dialogNumber: 2
    message: "\u0424\u0438\u043D:                                                                                                                
      \u041B\u0430\u0434\u043D\u043E. \u041F\u043E\u0440\u0430 \u0432 \u043B\u0435\u0441."
