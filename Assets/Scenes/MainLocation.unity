  m_text: "\u0410 \u0432\u043E\u0442 \u0438 \u043F\u0435\u0440\u0432\u044B\u0439
    \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442 \u2014 \u041F\u043B\u0430\u0447\u0443\u0449\u0438\u0439
